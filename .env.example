# fixture mode needs no API key. Node 24+ and Chromium are required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Configure the chosen model's current USD price per million tokens.
ANTHROPIC_INPUT_USD_PER_MILLION=
ANTHROPIC_OUTPUT_USD_PER_MILLION=
MAX_COST_USD=0.50
# Optional multi-workspace API key selection.
ANTHROPIC_WORKSPACE_ID=
# Total evaluation budget, including outstanding reservations from interrupted runs.
# Required only for actual model evaluation; choose an explicit total before executing.
EVAL_MAX_COST_USD=
# Optional per-claim evaluation cost cap (bounded by MAX_COST_USD).
EVAL_CLAIM_MAX_COST_USD=
# Optional AI image generation. Photo-based production works without these.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=
# Reserve this USD amount for each image attempt, including failed/unknown requests.
# Set using the selected model's current prices and keep within MAX_COST_USD.
IMAGE_MAX_COST_USD_PER_CALL=
# Optional local image store (defaults to data/images).
TIMESTORY_IMAGE_DIR=

# Optional NAVER Dynamic Map browser public Client ID (never the Client Secret).
# Register http://127.0.0.1 and, if used, http://localhost as Web service URLs.
# Do not include ports or paths. Only this public ID is exposed by /api/map-config.
NCP_MAPS_CLIENT_ID=
