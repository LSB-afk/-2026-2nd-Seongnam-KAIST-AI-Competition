{
  "name": "seongnam-timestory",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/evaluate.ts",
    "eval:claims": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate-claims.ts",
    "eval:live": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate-live.ts",
    "eval:smoke": "node --env-file-if-exists=.env.local --import tsx scripts/evaluate-live.ts --smoke",
    "sources:probe": "tsx scripts/probe-sources.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans-kr": "5.3.0",
    "fflate": "0.8.3",
    "next": "16.3.4",
    "playwright": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "5.0.0"
  },
  "type": "module"
}
